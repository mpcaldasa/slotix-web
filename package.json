{
  "name": "slotix-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json --host 127.0.0.1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "test:coverage": "ng test --watch=false --coverage --coverage-include='src/app/**/*.ts' --coverage-exclude='**/*.spec.ts'",
    "lint": "eslint src",
    "format": "prettier --write src scripts e2e *.json *.md eslint.config.js playwright*.ts .github/workflows/*.yml deploy",
    "format:check": "prettier --check src scripts e2e *.json *.md eslint.config.js playwright*.ts .github/workflows/*.yml deploy",
    "contract:generate": "node scripts/generate-contract.mjs",
    "contract:check": "node scripts/generate-contract.mjs --check",
    "e2e": "playwright test",
    "e2e:real": "playwright test --config playwright.real.config.ts",
    "audit:prod": "npm audit --omit=dev",
    "audit:dev": "npm audit",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run e2e"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@vitest/coverage-v8": "5.0.3",
    "angular-eslint": "22.5.0",
    "eslint": "10.12.0",
    "jsdom": "30.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "type": "module"
}
